START hilow_game

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound:"
    INPUT lower_bound

    OUTPUT "Enter the upper bound:"
    INPUT upper_bound

    WHILE lower_bound >= upper_bound
        OUTPUT "Invalid bounds. The lower bound must be less than the upper bound."

        OUTPUT "Enter the lower bound:"
        INPUT lower_bound

        OUTPUT "Enter the upper bound:"
        INPUT upper_bound
    END WHILE

    # Establish the number the player is trying to guess.
    GENERATE random_number between lower_bound and upper_bound

    # Play the game.
    OUTPUT "Enter your guess:"
    INPUT guess

    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Invalid guess. Enter a number between the lower and upper bounds."
        INPUT guess
    END WHILE

    WHILE guess != random_number

        IF guess < random_number THEN
            OUTPUT "Too low. Guess higher."
        ELSE
            OUTPUT "Too high. Guess lower."
        END IF

        OUTPUT "Enter your guess:"
        INPUT guess

        WHILE guess < lower_bound OR guess > upper_bound
            OUTPUT "Invalid guess. Enter a number between the lower and upper bounds."
            INPUT guess
        END WHILE

    END WHILE

    OUTPUT "Correct! You guessed the number."

END hilow_game
